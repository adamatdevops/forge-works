{
  // Markdownlint configuration
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md

  // Default state for all rules
  "default": true,

  // MD001 - Heading levels should only increment by one level at a time
  "MD001": true,

  // MD003 - Heading style (use ATX style: # Heading)
  "MD003": {
    "style": "atx"
  },

  // MD004 - Unordered list style (use dashes)
  "MD004": {
    "style": "dash"
  },

  // MD007 - Unordered list indentation (2 spaces)
  "MD007": {
    "indent": 2
  },

  // MD009 - Trailing spaces (allow 2 for line breaks)
  "MD009": {
    "br_spaces": 2
  },

  // MD010 - Hard tabs
  "MD010": true,

  // MD012 - Multiple consecutive blank lines
  "MD012": {
    "maximum": 2
  },

  // MD013 - Line length (disabled - let editor/formatter handle)
  "MD013": false,

  // MD024 - Multiple headings with the same content
  "MD024": {
    "siblings_only": true
  },

  // MD025 - Multiple top-level headings
  "MD025": true,

  // MD026 - Trailing punctuation in heading
  "MD026": {
    "punctuation": ".,;:!"
  },

  // MD029 - Ordered list item prefix (use ordered numbers)
  "MD029": {
    "style": "ordered"
  },

  // MD030 - Spaces after list markers
  "MD030": {
    "ul_single": 1,
    "ol_single": 1,
    "ul_multi": 1,
    "ol_multi": 1
  },

  // MD031 - Fenced code blocks should be surrounded by blank lines
  "MD031": true,

  // MD032 - Lists should be surrounded by blank lines
  "MD032": true,

  // MD033 - Inline HTML (allow certain elements)
  "MD033": {
    "allowed_elements": [
      "br",
      "details",
      "summary",
      "sub",
      "sup",
      "kbd",
      "img",
      "a"
    ]
  },

  // MD034 - Bare URLs (use proper link syntax)
  "MD034": true,

  // MD035 - Horizontal rule style
  "MD035": {
    "style": "---"
  },

  // MD036 - Emphasis used instead of a heading
  "MD036": false,

  // MD040 - Fenced code blocks should have a language specified
  "MD040": true,

  // MD041 - First line should be a top-level heading
  "MD041": true,

  // MD044 - Proper names should have correct capitalization
  "MD044": {
    "names": [
      "ForgeWorks",
      "GitHub",
      "ArgoCD",
      "Kubernetes",
      "Docker",
      "PostgreSQL",
      "Redis",
      "FastAPI",
      "Next.js",
      "TypeScript",
      "Python",
      "JavaScript"
    ],
    "code_blocks": false
  },

  // MD045 - Images should have alternative text
  "MD045": true,

  // MD046 - Code block style (fenced)
  "MD046": {
    "style": "fenced"
  },

  // MD047 - Files should end with a single newline character
  "MD047": true,

  // MD048 - Code fence style (backticks)
  "MD048": {
    "style": "backtick"
  },

  // MD049 - Emphasis style (asterisks)
  "MD049": {
    "style": "asterisk"
  },

  // MD050 - Strong style (asterisks)
  "MD050": {
    "style": "asterisk"
  }
}
