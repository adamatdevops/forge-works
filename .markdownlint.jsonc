{
  // Markdownlint configuration
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md

  // Default state for all rules
  "default": true,

  // MD001 - Heading levels should only increment by one level at a time
  "MD001": true,

  // MD003 - Heading style (use ATX style: # Heading)
  "MD003": {
    "style": "atx"
  },

  // MD004 - Unordered list style (disabled - allow asterisks and dashes)
  "MD004": false,

  // MD007 - Unordered list indentation (2 spaces)
  "MD007": {
    "indent": 2
  },

  // MD009 - Trailing spaces (allow 2 for line breaks)
  "MD009": {
    "br_spaces": 2
  },

  // MD010 - Hard tabs
  "MD010": true,

  // MD012 - Multiple consecutive blank lines
  "MD012": {
    "maximum": 2
  },

  // MD013 - Line length (disabled - let editor/formatter handle)
  "MD013": false,

  // MD024 - Multiple headings with the same content
  "MD024": {
    "siblings_only": true
  },

  // MD022 - Headings should be surrounded by blank lines (disabled)
  "MD022": false,

  // MD025 - Multiple top-level headings (disabled for flexibility)
  "MD025": false,

  // MD026 - Trailing punctuation in heading (allow colons)
  "MD026": {
    "punctuation": ".,;!"
  },

  // MD029 - Ordered list item prefix (disabled - allow any style)
  "MD029": false,

  // MD030 - Spaces after list markers
  "MD030": {
    "ul_single": 1,
    "ol_single": 1,
    "ul_multi": 1,
    "ol_multi": 1
  },

  // MD031 - Fenced code blocks should be surrounded by blank lines (disabled)
  "MD031": false,

  // MD032 - Lists should be surrounded by blank lines (disabled)
  "MD032": false,

  // MD033 - Inline HTML (allow certain elements)
  // p + em added for the centered architecture image + caption pattern in README.md.
  "MD033": {
    "allowed_elements": [
      "br",
      "details",
      "summary",
      "sub",
      "sup",
      "kbd",
      "img",
      "a",
      "p",
      "em"
    ]
  },

  // MD034 - Bare URLs (disabled - allow bare URLs in docs)
  "MD034": false,

  // MD035 - Horizontal rule style
  "MD035": {
    "style": "---"
  },

  // MD036 - Emphasis used instead of a heading
  "MD036": false,

  // MD040 - Fenced code blocks should have a language specified (disabled)
  "MD040": false,

  // MD041 - First line should be a top-level heading (disabled)
  "MD041": false,

  // MD044 - Proper names should have correct capitalization (disabled)
  "MD044": false,

  // MD058 - Tables should be surrounded by blank lines (disabled)
  "MD058": false,

  // MD060 - Table column style (disabled)
  "MD060": false,

  // MD045 - Images should have alternative text
  "MD045": true,

  // MD046 - Code block style (fenced)
  "MD046": {
    "style": "fenced"
  },

  // MD047 - Files should end with a single newline character
  "MD047": true,

  // MD048 - Code fence style (backticks)
  "MD048": {
    "style": "backtick"
  },

  // MD049 - Emphasis style (disabled - allow both asterisks and underscores)
  "MD049": false,

  // MD050 - Strong style (asterisks)
  "MD050": {
    "style": "asterisk"
  }
}
