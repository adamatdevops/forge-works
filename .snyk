# Snyk (https://snyk.io) policy file
# Learn more: https://snyk.io/docs/policy-file

version: v1.25.0

# Ignore specific vulnerabilities
ignore: {}

# Patches to apply
patch: {}

# Exclude certain paths from scanning
exclude:
  global:
    # Test fixtures and mock data
    - "**/__tests__/**"
    - "**/tests/**"
    - "**/test/**"
    - "**/*.test.*"
    - "**/*.spec.*"
    # Build artifacts
    - "**/dist/**"
    - "**/build/**"
    - "**/.next/**"
    - "**/node_modules/**"
    # Virtual environments
    - "**/venv/**"
    - "**/.venv/**"
    - "**/env/**"
    # Documentation
    - "**/docs/**"
