# ForgeWorks Environment Configuration
# Copy this file to .env and update values as needed

# Application
APP_NAME=ForgeWorks
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_PREFIX=/api
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forgedb

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# ML Model
ML_MODEL_PATH=models/template_recommender.pkl
ML_CONFIDENCE_THRESHOLD=0.7
