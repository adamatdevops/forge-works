{
  "name": "@forge-works/backend",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeWorks Backend - FastAPI Python application (Turbo wrapper)",
  "scripts": {
    "dev": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "echo 'Python backend - no build step required'",
    "test": "pytest -v --cov=app --cov-report=term-missing",
    "test:unit": "pytest tests/unit -v",
    "test:integration": "pytest tests/integration -v",
    "test:cov": "pytest --cov=app --cov-report=html",
    "lint": "ruff check . && ruff format --check .",
    "lint:fix": "ruff check --fix . && ruff format .",
    "format": "ruff format .",
    "typecheck": "mypy app",
    "clean": "rm -rf __pycache__ .pytest_cache .coverage htmlcov .mypy_cache .ruff_cache *.egg-info",
    "migrate": "alembic upgrade head",
    "migrate:create": "alembic revision --autogenerate -m",
    "migrate:down": "alembic downgrade -1",
    "migrate:reset": "alembic downgrade base && alembic upgrade head",
    "seed": "python -m app.db.seed",
    "db:setup": "pnpm run migrate && pnpm run seed"
  },
  "keywords": [
    "fastapi",
    "python",
    "backend",
    "idp",
    "platform-engineering"
  ]
}
