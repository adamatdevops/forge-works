# Snyk (https://snyk.io) policy file — Maven module mirror
# Learn more: https://snyk.io/docs/policy-file
#
# MIRROR of /.snyk at the repo root. The root file is the source-of-truth
# and carries the same 8 transitive CVE deferrals; this per-module copy
# exists because the Snyk Marketplace App auto-detects `.snyk` next to
# each scanned manifest (pom.xml) — it does not honor `--policy-path`
# the way the in-CI CLI does (AB-008 / `research/github_apps/snyk_app_migration.md`).
#
# Keep this file byte-identical to the other three Maven mirrors and in
# semantic lockstep with /.snyk. There is also a parallel ignore list in
# OWASP DC format at /dependency-check-suppressions.xml (AB-023 Step 2).
# When you change one, update ALL SIX files in the same commit
# (5 .snyk + 1 suppressions.xml).
#
# Each `ignore` entry must include:
#   - reason     why we're not fixing right now (link an issue when possible)
#   - expires    ISO date (UTC) when this ignore auto-revives in CI
#   - created    when this entry landed
#
# Process: when an ignore expires, Snyk re-fails the build, forcing re-evaluation.
# Don't extend an expiry without a fresh decision noted in the reason.

version: v1.25.0

# ----------------------------------------------------------------------------
# Ignore specific vulnerabilities
# ----------------------------------------------------------------------------
ignore:
  # ===== Apache Kafka clients (transitive via flink-connector-kafka 3.3.0-1.20) =====
  # Fix path: bump flink-connector-kafka 3.3.0 → 4.0.1-2.0, which requires
  # Flink 2.0 (major). Tracked under task #24 — Flink 1.20 → 2.0 evaluation.
  # Re-evaluate 2026-08-10 (90 days). If Flink 2.0 hasn't landed by then,
  # take a fresh decision instead of mechanically extending.

  SNYK-JAVA-ORGAPACHEKAFKA-10336719:
    - "*":
        reason: >-
          SSRF in kafka-clients@3.4.0 (transitive via flink-connector-kafka).
          Fix requires Flink 1.20 → 2.0 upgrade (task #24). Mitigated in our
          context: Flink jobs only consume from in-cluster Kafka brokers
          (Strimzi), no external broker URLs are accepted at runtime.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-05-10T00:00:00.000Z"

  SNYK-JAVA-ORGAPACHEKAFKA-10350513:
    - "*":
        reason: >-
          Deserialization of untrusted data in kafka-clients@3.4.0
          (transitive). Fix requires Flink 1.20 → 2.0 (task #24). Mitigated:
          we control all producers (forge-works normalizers) and consumers
          (forge-works Flink jobs); no third-party data enters these topics.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-05-10T00:00:00.000Z"

  SNYK-JAVA-ORGAPACHEKAFKA-10350567:
    - "*":
        reason: >-
          Deserialization of untrusted data in kafka-clients@3.4.0
          (transitive). Same fix path as -10350513. Same mitigation.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-05-10T00:00:00.000Z"

  SNYK-JAVA-ORGAPACHEKAFKA-8528112:
    - "*":
        reason: >-
          Incorrect implementation of authentication algorithm in
          kafka-clients@3.4.0 (transitive). Fix requires Flink 2.0 (task #24).
          Mitigated: in-cluster traffic is mTLS via Strimzi; SASL is not used
          for inter-pod Kafka traffic in our deployment.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-05-10T00:00:00.000Z"

  SNYK-JAVA-ORGAPACHEKAFKA-16300072:
    - "*":
        reason: >-
          Insertion of sensitive information into log file in
          kafka-clients@3.4.0. No direct upgrade or patch available without
          flink-connector-kafka bump (task #24). Mitigated: pod logs are
          shipped to a private observability stack; not externally exposed.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-05-10T00:00:00.000Z"

  # ===== Apache Commons Lang3 (transitive via flink-streaming-java 1.20.3) =====
  # Fix path: bump flink-streaming-java to 2.0.1 (Flink 2.0 — task #24).
  SNYK-JAVA-ORGAPACHECOMMONS-10734078:
    - "*":
        reason: >-
          Uncontrolled recursion in commons-lang3@3.12.0 (transitive via
          flink-streaming-java 1.20.3). Fix requires Flink 2.0 (task #24).
          Reachability: only used by Flink internals on trusted, in-cluster
          serialization paths.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-05-10T00:00:00.000Z"

  # ===== lz4-java (transitive via flink-streaming-java 1.20.3) =====
  # Both fixed by Flink 2.0 upgrade (task #24).
  SNYK-JAVA-ORGLZ4-14151788:
    - "*":
        reason: >-
          Out-of-bounds read in lz4-java@1.8.0 (transitive via
          flink-streaming-java 1.20.3). Fix requires Flink 2.0 (task #24).
          Reachability: lz4 only decompresses Kafka messages from our own
          producers — no untrusted compressed input.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-05-10T00:00:00.000Z"

  SNYK-JAVA-ORGLZ4-14219384:
    - "*":
        reason: >-
          Insertion of sensitive information into sent data in lz4-java@1.8.0
          (transitive). Same fix path and mitigation as -14151788.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-05-10T00:00:00.000Z"

  # ===== NEW 2026-08-01 — jackson-databind (pinned at 2.18.7 in each Flink pom.xml) =====
  # Fix path: bump jackson.version 2.18.7 → 2.18.9 in the pom.xml of every Flink
  # module (pattern-matcher, event-router, insight-generator, dr-predictor).
  # Small, non-Flink-version-dependent change. Aligned with the 2026-08-10Z
  # Flink-transitive review checkpoint so all Flink-related deferrals are
  # reconsidered together.

  SNYK-JAVA-COMFASTERXMLJACKSONCORE-17972608:
    - "*":
        reason: >-
          CVE-2026-59889 (High, CVSS 7.1) — Incorrect Authorization in
          jackson-databind when @JsonView and @JsonUnwrapped are combined.
          Fix: bump jackson.version to 2.18.9 in all Flink poms. Reachability:
          forge-works Flink jobs use @JsonIgnoreProperties on flat POJOs with
          no @JsonView or @JsonUnwrapped annotations, so the vulnerable code
          path is not exercised. Same trust boundary as existing Kafka CVEs
          (in-cluster producers only, no third-party JSON reaches Flink).
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-08-01T00:00:00.000Z"

  SNYK-JAVA-COMFASTERXMLJACKSONCORE-17440366:
    - "*":
        reason: >-
          CVE-2026-54513 (Critical, CVSS 9.2) — Incomplete List of Disallowed
          Inputs in BasicPolymorphicTypeValidator.allowIfSubTypeIsArray().
          Fix: bump jackson.version to 2.18.8+ in all Flink poms. Reachability:
          forge-works Flink jobs do NOT enable polymorphic type validation on
          any deserialization path (no @JsonTypeInfo, no PolymorphicTypeValidator
          configured), so the vulnerable validator method is never invoked.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-08-01T00:00:00.000Z"

  SNYK-JAVA-COMFASTERXMLJACKSONCORE-17440598:
    - "*":
        reason: >-
          CVE-2026-54512 (Critical, CVSS 9.2) — Deserialization of Untrusted
          Data via generic type argument bypass in
          DatabindContext._resolveAndValidateGeneric(). Fix: bump jackson.version
          to 2.18.8+ in all Flink poms. Reachability: exploit requires (a)
          polymorphic type validation enabled, (b) untrusted JSON input, (c) a
          gadget class on classpath. Forge-works Flink jobs meet zero of these:
          no polymorphic validators, no untrusted input (Kafka topics only
          receive from in-cluster normalizers), shaded Jackson classpath is
          minimal.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-08-01T00:00:00.000Z"

  # ===== NEW 2026-08-01 — lz4-java (transitive via flink-streaming-java 1.20.3) =====
  SNYK-JAVA-ORGLZ4-18313067:
    - "*":
        reason: >-
          CVE-2026-59949 (High, CVSS 8.3) — NULL Pointer Dereference and OOB
          read in native XXHash when SafeUtils.checkRange() skips validation
          on len==0. No fixed lz4-java version exists yet. Documented workaround
          (XXHashFactory.safeInstance() to avoid JNI) is a Flink-internal
          change requiring Flink 2.0 (task #24) — same fix path as the two
          existing lz4 CVEs above. Reachability: identical to
          SNYK-JAVA-ORGLZ4-14151788 — lz4 only decompresses Kafka messages
          from our own producers, no untrusted compressed input.
        expires: "2026-08-10T00:00:00.000Z"
        created: "2026-08-01T00:00:00.000Z"

# ----------------------------------------------------------------------------
# Patches to apply
# ----------------------------------------------------------------------------
patch: {}

# ----------------------------------------------------------------------------
# Exclude certain paths from scanning
# ----------------------------------------------------------------------------
exclude:
  global:
    # Test fixtures and mock data
    - "**/__tests__/**"
    - "**/tests/**"
    - "**/test/**"
    - "**/*.test.*"
    - "**/*.spec.*"
    # Build artifacts
    - "**/dist/**"
    - "**/build/**"
    - "**/.next/**"
    - "**/node_modules/**"
    # Virtual environments
    - "**/venv/**"
    - "**/.venv/**"
    - "**/env/**"
    # Documentation
    - "**/docs/**"
