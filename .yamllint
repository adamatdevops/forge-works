# yamllint configuration
# https://yamllint.readthedocs.io/en/stable/configuration.html

extends: default

yaml-files:
  - "*.yaml"
  - "*.yml"
  - ".yamllint"

ignore: |
  node_modules/
  venv/
  .venv/
  dist/
  build/
  .next/
  .turbo/
  # Helm charts often have template syntax
  **/templates/*.yaml
  **/templates/*.yml
  # Vendored third-party agent skills (byte-verbatim upstream content)
  .skills/

rules:
  # Line length - allow longer lines for URLs and complex values
  line-length:
    max: 120
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true

  # Indentation - 2 spaces, consistent
  indentation:
    spaces: 2
    indent-sequences: true
    check-multi-line-strings: false

  # Braces - allow inline for short mappings
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
    min-spaces-inside-empty: 0
    max-spaces-inside-empty: 0

  # Brackets - allow inline for short sequences
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
    min-spaces-inside-empty: 0
    max-spaces-inside-empty: 0

  # Comments - require space after #
  comments:
    require-starting-space: true
    ignore-shebangs: true
    min-spaces-from-content: 1

  # Comments indentation - disabled for commented-out code blocks
  comments-indentation: disable

  # Document markers - optional
  document-start: disable
  document-end: disable

  # Empty lines
  empty-lines:
    max: 2
    max-start: 0
    max-end: 1

  # Key duplicates - error
  key-duplicates: enable

  # New line at end of file
  new-line-at-end-of-file: enable

  # Trailing spaces - error
  trailing-spaces: enable

  # Truthy values - allow various boolean representations
  truthy:
    allowed-values: ["true", "false", "yes", "no", "on", "off"]
    check-keys: false

  # Colons
  colons:
    max-spaces-before: 0
    max-spaces-after: 1

  # Commas
  commas:
    max-spaces-before: 0
    min-spaces-after: 1
    max-spaces-after: 1

  # Hyphens
  hyphens:
    max-spaces-after: 1

  # Quoted strings - disabled to allow consistent quoting style
  quoted-strings: disable
