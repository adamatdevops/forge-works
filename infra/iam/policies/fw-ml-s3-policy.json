{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ModelsReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::fw-models-dev",
        "arn:aws:s3:::fw-models-dev/*"
      ]
    },
    {
      "Sid": "LogsWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::fw-logs-dev",
        "arn:aws:s3:::fw-logs-dev/*"
      ]
    }
  ]
}
