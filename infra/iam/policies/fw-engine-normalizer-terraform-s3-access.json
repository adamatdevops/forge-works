{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListBucketScopedToTerraformPrefix",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::fw-state-dev",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "normalizer/configs/terraform",
                        "normalizer/configs/terraform/*"
                    ]
                }
            }
        },
        {
            "Sid": "ReadWriteTerraformConfigs",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::fw-state-dev/normalizer/configs/terraform/*"
        }
    ]
}
